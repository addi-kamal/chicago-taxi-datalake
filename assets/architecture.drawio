A;strokeColor=#888888;strokeWidth=2;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="95" y="535" width="170" height="90" as="geometry"/></mxCell><mxCell id="p_ing" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="200" height="480" as="geometry"/></mxCell><mxCell id="extract" value='&lt;b&gt;&lt;font style="font-size:15px" color="#017CEE"&gt;Python&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#333333"&gt;extract_day&lt;br&gt;1 tâche par jour&lt;br&gt;pagination $order=trip_id&lt;br&gt;4 en parallèle, 3 retries&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F8FE;strokeColor=#017CEE;strokeWidth=2;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="335" y="265" width="170" height="130" as="geometry"/></mxCell><mxCell id="spark_ing" value='&lt;b&gt;&lt;font style="font-size:15px" color="#E25A1C"&gt;Apache Spark&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#333333"&gt;PySpark 3.5.4 (API Python)&lt;br&gt;batch : landing → bronze&lt;br&gt;CSV lus en texte&lt;br&gt;+ colonnes techniques&lt;br&gt;contrôle des volumes&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6F1;strokeColor=#E25A1C;strokeWidth=2;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="335" y="450" width="170" height="130" as="geometry"/></mxCell><mxCell id="p_lake" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="640" height="480" as="geometry"/></mxCell><mxCell id="box_store" value="Data Lake (stockage)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="580" y="255" width=