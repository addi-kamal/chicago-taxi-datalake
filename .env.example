# -----------------------------------------------------------------------------
# Configuration du pipeline Chicago Taxi Trips.
#
# Modèle du fichier `.env`. Les secrets sont laissés vides ici et générés
# aléatoirement par :
#     python scripts/generate_env.py      (ou : make env)
# Les autres valeurs (période, ports, endpoint S3...) peuvent ensuite être
# ajustées dans `.env`, par exemple pour pointer vers Ceph RGW.
# `.env` n'est jamais versionné.
# -----------------------------------------------------------------------------

# --- Stockage objet S3 (MinIO en local / Ceph RGW en prod) -------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=datalake
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_USE_SSL=false
# boto3 >= 1.36 / AWS SDK Java v2 récents : checksums CRC par défaut, refusés par
# certaines versions de Ceph RGW. On ne les envoie que lorsqu'ils sont requis.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# --- Catalogue Iceberg (JDBC sur PostgreSQL) ---------------------------------
ICEBERG_CATALOG_NAME=iceberg
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres:5432/iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=
ICEBERG_WAREHOUSE=s3://bronze/warehouse

# --- PostgreSQL (compte administrateur + bases applicatives) -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=

# --- Airflow -----------------------------------------------------------------
AIRFLOW_ADMIN_USER=airflow_admin
AIRFLOW_ADMIN_PASSWORD=
# Clé partagée webserver/scheduler (signature des sessions, lecture des logs).
AIRFLOW_SECRET_KEY=
# Chiffrement des connexions/variables Airflow en base.
AIRFLOW_FERNET_KEY=

# --- Spark -------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=3g
SPARK_SHUFFLE_PARTITIONS=16

# --- Trino -------------------------------------------------------------------
TRINO_HOST=trino
TRINO_PORT=8080

# --- Superset (dashboard BI) -------------------------------------------------
SUPERSET_ADMIN_USER=superset_admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_SECRET_KEY=

# --- DBeaver (CloudBeaver, client SQL web sur Trino) -------------------------
DBEAVER_ADMIN_USER=cbadmin
DBEAVER_ADMIN_PASSWORD=

# --- Pipeline ----------------------------------------------------------------
# soda   : téléchargement réel depuis data.cityofchicago.org (défaut)
# sample : jeu d'exemple embarqué (hors ligne) - utiliser alors la période
#          2023-01-01 -> 2023-01-04
PIPELINE_SOURCE=soda
# Période traitée (fin exclue). Par défaut une semaine : validation rapide (~10 min).
# Trimestre complet (T1 2023, ~1,45 M trajets, 30-45 min) : PIPELINE_END_DATE=2023-04-01
PIPELINE_START_DATE=2023-01-01
PIPELINE_END_DATE=2023-01-08
DQ_MAX_REJECT_PCT=5
# Jeton applicatif SODA (gratuit, recommandé pour éviter le throttling)
SODA_APP_TOKEN=
SODA_PAGE_SIZE=50000
# Nombre de jours téléchargés en parallèle (politesse envers l'API publique)
EXTRACT_PARALLELISM=4
